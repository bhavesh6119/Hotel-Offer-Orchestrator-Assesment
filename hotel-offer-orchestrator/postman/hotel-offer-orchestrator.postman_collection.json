{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Hotel Offer Orchestrator",
    "description": "API collection for the Hotel Offer Orchestrator backend assessment project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Hotels",
      "item": [
        {
          "name": "Get Hotels (all)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "delhi" }]
            },
            "description": "Triggers a Temporal workflow to fetch and deduplicate hotel offers from both suppliers, caches the result in Redis, and returns the merged list."
          }
        },
        {
          "name": "Get Hotels (price filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=2000&maxPrice=5000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" },
                { "key": "minPrice", "value": "2000" },
                { "key": "maxPrice", "value": "5000" }
              ]
            },
            "description": "Returns cached hotel offers filtered by price range. Filtering happens inside the cache layer."
          }
        },
        {
          "name": "Get Hotels (missing city — 400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"]
            },
            "description": "Should return 400 Bad Request because city is required."
          }
        }
      ]
    },
    {
      "name": "Supplier Mocks",
      "item": [
        {
          "name": "Supplier A — raw hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/supplierA/hotels",
              "host": ["{{baseUrl}}"],
              "path": ["supplierA", "hotels"]
            }
          }
        },
        {
          "name": "Supplier B — raw hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/supplierB/hotels",
              "host": ["{{baseUrl}}"],
              "path": ["supplierB", "hotels"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Returns health status for Redis, Temporal, Supplier A, and Supplier B."
          }
        }
      ]
    }
  ]
