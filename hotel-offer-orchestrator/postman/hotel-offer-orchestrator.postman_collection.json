    {
      "name": "Health",
      "description": "Checks health of Redis, Temporal, and mock suppliers.",
      "item": [
        {
          "name": "GET /health - System Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Status is ok or degraded\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.be.oneOf([\"ok\", \"degraded\"]);",
                  "});",
                  "",
                  "pm.test(\"Has redis, temporal, supplierA, supplierB fields\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"redis\");",
                  "    pm.expect(json).to.have.property(\"temporal\");",
                  "    pm.expect(json).to.have.property(\"supplierA\");",
                  "    pm.expect(json).to.have.property(\"supplierB\");",
                  "    pm.expect(json.redis).to.have.property(\"status\");",
                  "    pm.expect(json.temporal).to.have.property(\"status\");",
                  "    pm.expect(json.supplierA).to.have.property(\"status\");",
                  "    pm.expect(json.supplierB).to.have.property(\"status\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Returns status for Redis, Temporal, and mock suppliers."
          }
        }
      ]
    },
    {
      "name": "Hotels",
      "description": "Retrieves and merges hotel offers from suppliers.",
      "item": [
        {
          "name": "GET /api/hotels?city=delhi - Deduplication & Sorting",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var hotels = pm.response.json();",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(hotels).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "pm.test(\"No duplicate hotel names (case-insensitive)\", function () {",
                  "    var seen = new Set();",
                  "    hotels.forEach(function (h) {",
                  "        var lower = h.name.trim().toLowerCase();",
                  "        pm.expect(seen.has(lower), \"Duplicate found: \" + h.name).to.be.false;",
                  "        seen.add(lower);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Prices are sorted ascending\", function () {",
                  "    for (var i = 1; i < hotels.length; i++) {",
                  "        pm.expect(hotels[i].price).to.be.at.least(hotels[i - 1].price);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Every item has name, price, supplier, commissionPct\", function () {",
                  "    hotels.forEach(function (h) {",
                  "        pm.expect(h).to.have.property(\"name\").that.is.a(\"string\");",
                  "        pm.expect(h).to.have.property(\"price\").that.is.a(\"number\");",
                  "        pm.expect(h).to.have.property(\"supplier\").that.is.oneOf([\"Supplier A\", \"Supplier B\"]);",
                  "        pm.expect(h).to.have.property(\"commissionPct\").that.is.a(\"number\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"The Grand Palace is 4200 from Supplier B\", function () {",
                  "    var target = hotels.find(function (h) { return h.name.toLowerCase() === \"the grand palace\"; });",
                  "    pm.expect(target, \"The Grand Palace not found\").to.not.be.undefined;",
                  "    pm.expect(target.price).to.equal(4200);",
                  "    pm.expect(target.supplier).to.equal(\"Supplier B\");",
                  "});",
                  "",
                  "pm.test(\"Blue Horizon Inn is 2200 from Supplier A\", function () {",
                  "    var target = hotels.find(function (h) { return h.name.toLowerCase() === \"blue horizon inn\"; });",
                  "    pm.expect(target, \"Blue Horizon Inn not found\").to.not.be.undefined;",
                  "    pm.expect(target.price).to.equal(2200);",
                  "    pm.expect(target.supplier).to.equal(\"Supplier A\");",
                  "});",
                  "",
                  "pm.test(\"Radison is 3200 from Supplier A with no trailing space\", function () {",
                  "    var target = hotels.find(function (h) { return h.name.trim().toLowerCase() === \"radison\"; });",
                  "    pm.expect(target, \"Radison not found\").to.not.be.undefined;",
                  "    pm.expect(target.name).to.equal(\"Radison\");",
                  "    pm.expect(target.price).to.equal(3200);",
                  "    pm.expect(target.supplier).to.equal(\"Supplier A\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            },
            "description": "Returns merged, deduplicated, price-sorted hotels for Delhi."
          }
        },
