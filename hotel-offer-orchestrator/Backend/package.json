{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Backend service that orchestrates hotel offer aggregation via Temporal workflows",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "worker": "ts-node --transpile-only src/temporal/worker.ts",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/temporal/worker.ts",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "ioredis": "^5.4.1",
    "pino": "^9.3.1",
    "pino-pretty": "^11.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
